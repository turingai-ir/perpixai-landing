# Optional build-time overrides (defaults live in src/config.ts)
# NEXT_PUBLIC_PERPIX_APP_URL=https://app.perpixai.ir
# Query param the auth page reads to prefill the phone field
# NEXT_PUBLIC_PHONE_PARAM=phone
# local = 09121234567 | national = 9121234567 | intl = +989121234567
# NEXT_PUBLIC_PHONE_FORMAT=local

# Plans and models come from the Perpix API at build time (src/data/landing-snapshot.json is the fallback).
# LANDING_API_URL=https://api.perpixai.ir
# 1 = fail the build instead of falling back to the snapshot (use for release builds)
# LANDING_DATA_STRICT=1
# Same-origin proxy the browser refreshes from (nginx /api/landing); 'off' keeps the build-time data
# NEXT_PUBLIC_LANDING_API_URL=/api/landing

# Docker & local dev port
ROBOT_LANDING_PORT=5176
